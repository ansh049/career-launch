# Root Docker Compose Environment Template
# Copy this file to .env and replace placeholder values before running docker compose

# Frontend Web Application
CLIENT_URL=http://localhost:8080
VITE_API_URL=http://localhost:5000

# Backend Authentication & Security
JWT_SECRET=generate_at_least_32_character_random_string_for_jwt
AI_INTERNAL_TOKEN=generate_at_least_32_character_random_string_for_internal_ai

# LLM / Groq Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
