NODE_ENV=development
PORT=5000
# Extra allowed frontend origins can be comma-separated; localhost:5173 and localhost:8080 are allowed locally.
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/career-platform
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/career-platform-test
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
ACCESS_TOKEN_SECRET=replace-with-a-distinct-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-another-distinct-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CSRF_SECRET=replace-with-a-separate-long-random-secret
AI_SERVICE_URL=http://127.0.0.1:8000
AI_INTERNAL_TOKEN=replace-with-the-same-random-token-used-by-ai-service
RECRUITER_VERIFICATION_TOKEN=replace-with-an-admin-only-random-token
RESUME_STORAGE=s3
RESUME_S3_BUCKET=private-career-platform-resumes
AWS_REGION=us-east-1
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310